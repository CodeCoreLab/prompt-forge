{
  "appId": "com.promptforge.app",
  "productName": "Prompt Forge",
  "directories": {
    "output": "dist"
  },
  "files": [
    "src/**/*",
    "assets/**/*"
  ],
  "extraResources": [
    {
      "from": "rust-core/target/release/",
      "to": "rust-core/",
      "filter": [
        "prompt-forge-cli.exe"
      ]
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "assets/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "perMachine": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Prompt Forge"
  }
}
