{
  "package": {
    "productName": "Prompt Forge",
    "version": "1.0.0"
  },
  "build": {
    "appId": "com.promptforge.app",
    "productName": "Prompt Forge",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "rust-core/target/release/prompt-forge-cli.exe",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "rust-core/target/release/",
        "to": "rust-core/",
        "filter": ["prompt-forge-cli.exe"]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installMode": "currentUser",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Prompt Forge"
    }
  }
}
